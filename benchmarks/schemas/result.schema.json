{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierguard.org/schemas/benchmark-result-0.1.0.json",
  "title": "DEA benchmark adapter result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "case_id",
    "case_schema_version",
    "implementation",
    "run",
    "outcome",
    "model",
    "executions",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "protocol_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "case_schema_version": {
      "const": "0.1.0"
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/execution"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_field",
        "source_field",
        "operation",
        "reason"
      ],
      "properties": {
        "target_field": {
          "type": "string",
          "minLength": 1
        },
        "source_field": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "identity",
            "reciprocal",
            "rename",
            "reorder",
            "other"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "adapter_name",
        "adapter_version",
        "language",
        "runtime_version",
        "package_source",
        "package_license",
        "solver_name",
        "solver_version",
        "source_revision",
        "normalizations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_name": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "package_source": {
          "type": "string",
          "minLength": 1
        },
        "package_license": {
          "type": "string",
          "minLength": 1
        },
        "solver_name": {
          "type": "string",
          "minLength": 1
        },
        "solver_version": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "normalizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/normalization"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "operating_system",
        "machine",
        "command"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "message"
      ],
      "properties": {
        "category": {
          "enum": [
            "success",
            "invalid_input",
            "unsupported_model",
            "infeasible",
            "unbounded",
            "iteration_limit",
            "time_limit",
            "solution_limit",
            "numerical_failure",
            "solver_error",
            "adapter_error",
            "schema_error",
            "crash"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "orientation",
        "returns_to_scale",
        "slacks",
        "exclude_self",
        "reference_scope",
        "disposability",
        "score_convention"
      ],
      "properties": {
        "family": {
          "const": "radial_envelopment"
        },
        "orientation": {
          "enum": [
            "input",
            "output"
          ]
        },
        "returns_to_scale": {
          "enum": [
            "crs",
            "vrs",
            "nirs",
            "ndrs"
          ]
        },
        "slacks": {
          "enum": [
            "none",
            "normalized",
            "max_sum"
          ]
        },
        "exclude_self": {
          "type": "boolean"
        },
        "reference_scope": {
          "const": "in_sample"
        },
        "disposability": {
          "const": "strong_inputs_and_outputs"
        },
        "score_convention": {
          "enum": [
            "input_theta",
            "output_reciprocal_phi"
          ]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "relation",
        "dmu_names",
        "reference_names",
        "radial_factor",
        "technical_efficiency",
        "statuses",
        "audit_residual",
        "audit_tolerance",
        "data_fingerprint",
        "native_metrics"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "baseline",
            "name_aligned_primary_scores_equal"
          ]
        },
        "dmu_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reference_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "radial_factor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "technical_efficiency": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "optimal",
              "iteration_limit",
              "time_limit",
              "solution_limit",
              "infeasible",
              "unbounded",
              "error"
            ]
          }
        },
        "audit_residual": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "audit_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "data_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "native_metrics": {
          "type": "object"
        }
      }
    }
  }
}
