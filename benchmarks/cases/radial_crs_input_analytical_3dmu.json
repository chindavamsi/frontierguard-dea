      ],
      "statuses": [
        "optimal",
        "optimal",
        "optimal"
      ]
    }
  },
  "tolerances": {
    "absolute": 1e-09,
    "relative": 1e-08,
    "audit": 1e-07
  },
  "metamorphic_tests": [
