    "provenance": {
      "authority": "analytical",
      "description": "One-input/one-output CRS scores follow directly from each DMU's output-input ratio relative to A's frontier ray.",
      "repository_paths": [
        "tests/test_radial.py::test_crs_input_scores_match_hand_calculation",
        "tests/test_multiplier.py::analytical_data"
      ],
      "citation_keys": [
        "charnes-cooper-rhodes-1978"
      ],
      "independent_external_reproduction": false
    },
    "derivation": [
      "A has output/input ratio 1 and defines the best CRS ray, so theta_A = 1.",
      "B produces one output with two inputs; A produces the same output with one input, so theta_B = 1/2.",
      "C produces two outputs with three inputs; two copies of A require two inputs, so theta_C = 2/3."
    ],
    "expected": {
